<?xml version="1.0" encoding="utf-8"?>
<config>
    <serverip>0.0.0.0</serverip>
    <serverport>8554</serverport>
    <loop_nums>-1</loop_nums>
    <multicast>0</multicast>
    <metadata>0</metadata>
    <rtsp_over_http>0</rtsp_over_http>
    <http_port>80</http_port>
    <rtsp_over_https>0</rtsp_over_https>
    <https_port>443</https_port>
    <need_auth>0</need_auth>
    <log_enable>1</log_enable>
    <log_level>3</log_level>
    <output>
        <url>live</url>
        <video>
            <codec>H264</codec>
            <width>640</width>
            <height>480</height>
            <framerate>25</framerate>
            <bitrate>1024000</bitrate>
        </video>
        <audio>
            <codec>OPUS</codec>
            <samplerate>16000</samplerate>
            <channels>1</channels>
            <bitrate>64000</bitrate>
        </audio>
    </output>
</config>
